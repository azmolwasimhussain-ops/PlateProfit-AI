# ==============================================================================
# PlateProfit AI - Environment Configuration Example
# ==============================================================================
# PlateProfit AI is a 100% private, local-first application.
# It does NOT require any external cloud API keys, tokens, or SaaS credentials.
#
# All recipes, inventory costs, invoices, and sales data are stored strictly
# on-device in browser local storage.
#
# Ollama integration connects directly to your local Ollama daemon
# (default: http://localhost:11434). Endpoint preferences can be configured
# directly in the Settings & AI UI without needing server-side environment variables.
# ==============================================================================

# Optional Next.js Port (Default: 3002)
PORT=3002

# Node Environment
NODE_ENV=development
